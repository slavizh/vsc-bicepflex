{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 180,
  "endOfLine": "auto",
  "bicepIndentStyle": "inherit",
  "bicepSortDeclarations": true,
  "bicepDeclarationOrder": [
    "metadata",
    "extension",
    "targetScope",
    "import",
    "type",
    "param",
    "func",
    "var",
    "resource",
    "module",
    "output"
  ],
  "bicepSortProperties": true,
  "bicepResourcePropertyOrder": [
    "name",
    "parent",
    "scope",
    "dependsOn",
    "location",
    "tags",
    "identity",
    "kind",
    "sku",
    "zones",
    "plan",
    "*",
    "properties"
  ],
  "bicepModulePropertyOrder": [
    "name",
    "scope",
    "dependsOn",
    "*",
    "params"
  ],
  "bicepSortDecorators": true,
  "bicepDecoratorOrder": [
    "export",
    "sealed",
    "description",
    "metadata",
    "discriminator",
    "secure",
    "allowed",
    "minLength",
    "maxLength",
    "minValue",
    "maxValue",
    "batchSize"
  ],
  "bicepObjectLayout": "multiline",
  "bicepArrayLayout": "compact",
  "bicepDeclarationSpacing": "separate",
  "bicepPropertyBlankLines": false,
  "bicepTypeOrder": "dependents-first",
  "bicepFunctionOrder": "dependencies-first",
  "bicepVariablePlacement": "first-use",
  "bicepExistingResourcePlacement": "first-use",
  "bicepOutputPlacement": "dependency",
  "bicepOutputOnlyVariables": "end",
  "bicepNestedResources": "last",
  "bicepQuoteProperties": "as-needed",
  "bicepLambdaParentheses": "avoid",
  "bicepDescriptionWidth": "ignore",
  "bicepDependencyOrder": "ready-first",
  "bicepUnusedDeclarations": "boundary",
  "bicepSectionComments": "boundary",
  "bicepIgnoredDeclarations": "move",
  "bicepResourceModuleOrder": "combined",
  "bicepImportSpacing": "compact",
  "bicepUnionLayout": "auto",
  "bicepConditionalHeader": "inline",
  "bicepLogicalCallLayout": "inline",
  "bicepLoopLayout": "auto",
  "bicepImportMemberOrder": "preserve",
  "bicepTypeMemberOrder": "preserve"
}
